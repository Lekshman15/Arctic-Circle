generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductType {
  SPLIT
  WINDOW
  STABILIZER
}

enum OrderStatus {
  PLACED
  DELIVERED
}

enum ApplianceType {
  AC
  STABILIZER
  WASHING_MACHINE
  FRIDGE
}

enum TicketStatus {
  OPEN
  COMPLETED
}

// Single table for both admins and customers, distinguished by role.
// Simpler than a separate Admin table — one login path, one place to look someone up.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  orders  Order[]
  tickets Ticket[]

  @@map("users")
}

model Product {
  id         String      @id @default(uuid())
  brand      String
  modelName  String
  tonnage    Float
  starRating Int
  type       ProductType
  price      Float
  imageUrl   String?
  createdAt  DateTime    @default(now())

  orders Order[]

  @@map("products")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  productId String
  status    OrderStatus @default(PLACED)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("orders")
}

model Ticket {
  id               String        @id @default(uuid())
  userId           String
  appliance        ApplianceType
  complaint        String
  address          String
  preferredTimings String
  status           TicketStatus  @default(OPEN)
  // Post-resolution feedback — only set once the ticket is completed
  rating           Int?
  feedback         String?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("tickets")
}
