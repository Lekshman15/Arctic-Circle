# PostgreSQL connection string. Create a database + role first, e.g.:
#   CREATE ROLE arctic_circle LOGIN PASSWORD '...';
#   CREATE DATABASE arctic_circle_dev OWNER arctic_circle;
#   ALTER ROLE arctic_circle CREATEDB;  -- needed for `prisma migrate dev`'s shadow database
DATABASE_URL="postgresql://arctic_circle:password@localhost:5432/arctic_circle_dev"

# Any long random string — used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=8081

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS="http://localhost:3000"

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME="Arctic Circle Admin"
ADMIN_EMAIL="admin@arcticcircle.com"
ADMIN_PASSWORD="change-this-password"
