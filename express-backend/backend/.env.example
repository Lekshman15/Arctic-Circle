# SQLite file — created automatically, no install or setup needed.
# For production, point this at a real Postgres/MySQL instance instead
# (and switch the "provider" in prisma/schema.prisma back to match).
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=8081

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS="http://localhost:3000"

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME="Arctic Circle Admin"
ADMIN_EMAIL="admin@arcticcircle.com"
ADMIN_PASSWORD="change-this-password"
